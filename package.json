{
  "name": "vscode-theme-randomizer",
  "displayName": "VS Code Theme Randomizer",
  "description": "Randomize the current VS Code color theme.",
  "version": "0.0.1",
  "publisher": "skyhoshi",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onCommand:vscodeThemeRandomizer.randomizeTheme",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscodeThemeRandomizer.randomizeTheme",
        "title": "Randomize Theme"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "vscodeThemeRandomizer.sidebarView",
          "name": "Theme Randomizer"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vscodeThemeRandomizer.randomizeTheme",
          "when": "view == vscodeThemeRandomizer.sidebarView",
          "group": "navigation"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vscodeThemeRandomizer.sidebarView",
        "contents": "[Randomize Theme](command:vscodeThemeRandomizer.randomizeTheme)",
        "when": "true"
      }
    ],
    "configuration": {
      "title": "VS Code Theme Randomizer",
      "properties": {
        "vscodeThemeRandomizer.randomizeOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Randomize the VS Code color theme when a window opens."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/**/*.test.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0"
  }
}
